# Clé secrète Flask : générer avec `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-moi
# URL publique (utilisée dans les QR codes et les emails)
BASE_URL=http://localhost:8000
ASSO_NAME=Mon association
# Préfixe des codes d'inventaire attribués automatiquement (INV-0001…)
ITEM_CODE_PREFIX=INV
# Dossier des données (base et photos) : /data dans Docker, ./data en développement
DATA_DIR=/data
# Fuseau horaire des dates affichées et des rappels
TZ=Europe/Paris
# Mettre à 1 derrière un reverse proxy (Caddy, Traefik, nginx) qui ajoute X-Forwarded-*
TRUST_PROXY=0
# Adresse d'écoute du port 8000 (Docker) : 127.0.0.1 si le proxy est sur ce serveur,
# sinon l'IP privée vue par le proxy (ex. 10.30.0.2). Jamais 0.0.0.0 sur une IP publique.
BIND_ADDR=127.0.0.1
# Content-Security-Policy : 1 = Report-Only (violations signalées dans la console du navigateur, rien n'est bloqué),
# 0 = appliquée. Voir docs/configuration.md avant de passer à 0.
CSP_REPORT_ONLY=1

# SMTP (facultatif — sans SMTP, les notifications restent dans l'appli)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Connexion OIDC (facultatif) — Authentik, Keycloak, Google, Microsoft Entra, Pocket ID…
# URL de rappel à déclarer chez le fournisseur : <BASE_URL>/connexion/oidc/retour
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Texte du bouton : « Se connecter avec … »
OIDC_PROVIDER_NAME=SSO
OIDC_SCOPES=openid email profile
# Groupes donnant un rôle (séparés par des virgules) ; sans groupe correspondant : Emprunteur
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
OIDC_PROF_GROUPS=
OIDC_REQUIRE_VERIFIED_EMAIL=1
# 1 = masquer le formulaire email / mot de passe
OIDC_ONLY=0
